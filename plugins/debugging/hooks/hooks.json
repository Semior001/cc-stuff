{
  "description": "Point Claude back at open RCA logs after context compaction",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/open-rca-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
